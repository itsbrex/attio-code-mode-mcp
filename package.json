{
  "name": "attio-mcp",
  "version": "1.0.0",
  "description": "Code Mode MCP server for Attio CRM — 130+ endpoints through 3 tools",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/spec',{recursive:true}); fs.copyFileSync('src/spec/openapi.json','dist/spec/openapi.json'); fs.mkdirSync('dist/context',{recursive:true}); fs.copyFileSync('src/context/llms.txt','dist/context/llms.txt');\"",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test:connection": "tsx src/test-connection.ts",
    "spec:update": "curl -fsSL https://api.attio.com/openapi/api -o src/spec/openapi.json && curl -fsSL https://docs.attio.com/llms.txt -o src/context/llms.txt && npm run build"
  },
  "keywords": [
    "mcp",
    "attio",
    "crm",
    "claude",
    "code-mode"
  ],
  "author": "Trial and Error Inc",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "axios": "^1.11.0",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
