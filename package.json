{
  "name": "attio-mcp",
  "version": "1.0.0",
  "description": "Code Mode MCP server for Attio CRM — 130+ endpoints through 3 tools",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/spec/openapi.json dist/spec/openapi.json && cp src/context/llms.txt dist/context/llms.txt",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test:connection": "tsx src/test-connection.ts"
  },
  "keywords": [
    "mcp",
    "attio",
    "crm",
    "claude",
    "code-mode"
  ],
  "author": "Trial and Error Inc",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "axios": "^1.11.0",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
